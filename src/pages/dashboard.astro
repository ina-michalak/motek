---
import { TriangleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import YarnCard from "@/components/yarn/YarnCard.astro";
import YarnPhotoPlaceholder from "@/components/yarn/YarnPhotoPlaceholder.astro";
import { createClient } from "@/lib/supabase";
import { listYarns } from "@/lib/services/yarns";
import YarnFilters from "@/components/yarn/YarnFilters";
import { parseYarnFilters, filterAndSortYarns, getYarnFilterOptions, hasActiveYarnFilters } from "@/lib/yarn-filters";

export const prerender = false;

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const yarns = supabase && user ? await listYarns(supabase, user.id) : [];
const { criteria, sort } = parseYarnFilters(Astro.url.searchParams);
const options = getYarnFilterOptions(yarns);
const visibleYarns = filterAndSortYarns(yarns, criteria, sort);
const warning = Astro.url.searchParams.get("warning");
const filtersOpenParam = Astro.url.searchParams.get("filtersOpen");
const filtersOpen = filtersOpenParam !== null ? filtersOpenParam === "1" : hasActiveYarnFilters(criteria);
const filtersActive = hasActiveYarnFilters(criteria);
---

<Layout title="Twoje włóczki">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-5xl">
      {
        warning && (
          <p class="border-warning-border bg-warning text-warning-foreground mb-4 flex items-center gap-2 rounded-lg border px-3 py-2 text-sm">
            <TriangleAlert className="size-4 shrink-0" />
            {warning}
          </p>
        )
      }

      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-bold sm:text-3xl">
          Twoje włóczki <span class="text-muted-foreground">
            {filtersActive ? `(Pokazano ${visibleYarns.length} z ${yarns.length})` : `(${yarns.length})`}
          </span>
        </h1>
        <div class="flex items-center gap-3">
          <a
            href="/yarns/new"
            class="border-border bg-card hover:bg-secondary rounded-lg border px-4 py-2 text-sm transition-colors"
          >
            + Dodaj włóczkę
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="border-border bg-card hover:bg-secondary rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </div>

      <YarnFilters
        options={options}
        initialCriteria={criteria}
        initialSort={sort}
        defaultOpen={filtersOpen}
        client:load
      />

      {
        yarns.length === 0 ? (
          <div class="border-border bg-card flex flex-col items-center rounded-2xl border p-12 text-center">
            <YarnPhotoPlaceholder class="text-muted-foreground mb-4 size-16" />
            <p class="text-muted-foreground">Nie masz jeszcze żadnej włóczki — dodaj pierwszą.</p>
            <a
              href="/yarns/new"
              class="border-border bg-background hover:bg-secondary mt-4 rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              + Dodaj włóczkę
            </a>
          </div>
        ) : visibleYarns.length === 0 ? (
          <div class="border-border bg-card flex flex-col items-center rounded-2xl border p-12 text-center">
            <p class="text-muted-foreground">Żadna włóczka nie pasuje do wybranych filtrów.</p>
            <a
              href="/dashboard"
              class="border-border bg-background hover:bg-secondary mt-4 rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Wyczyść filtry
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {visibleYarns.map((yarn) => (
              <YarnCard yarn={yarn} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
