---
import Layout from "@/layouts/Layout.astro";
import YarnCard from "@/components/yarn/YarnCard.astro";
import YarnPhotoPlaceholder from "@/components/yarn/YarnPhotoPlaceholder.astro";
import { createClient } from "@/lib/supabase";
import { listYarns } from "@/lib/services/yarns";

export const prerender = false;

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const yarns = supabase && user ? await listYarns(supabase, user.id) : [];
---

<Layout title="Twoje włóczki">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-5xl">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1
          class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl"
        >
          Twoje włóczki <span class="text-blue-100/50">({yarns.length})</span>
        </h1>
        <div class="flex items-center gap-3">
          <a
            href="/yarns/new"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            + Dodaj włóczkę
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </div>

      {
        yarns.length === 0 ? (
          <div class="flex flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-12 text-center backdrop-blur-xl">
            <YarnPhotoPlaceholder class="mb-4 size-16 text-blue-100/30" />
            <p class="text-blue-100/80">Nie masz jeszcze żadnej włóczki — dodaj pierwszą.</p>
            <a
              href="/yarns/new"
              class="mt-4 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              + Dodaj włóczkę
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {yarns.map((yarn) => (
              <YarnCard yarn={yarn} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
