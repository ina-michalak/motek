---
import { Star, TriangleAlert, CircleAlert } from "lucide-react";
import { z } from "zod";
import Layout from "@/layouts/Layout.astro";
import YarnPhotoPlaceholder from "@/components/yarn/YarnPhotoPlaceholder.astro";
import { createClient } from "@/lib/supabase";
import { getYarnById } from "@/lib/services/yarns";
import { listSubstituteSuggestions, getAcceptedSubstitutes } from "@/lib/services/substitutes";
import SubstituteSuggestions from "@/components/yarn/SubstituteSuggestions";
import EditYarnDialog from "@/components/yarn/EditYarnDialog";
import DeleteYarnButton from "@/components/yarn/DeleteYarnButton";
import { isYarnExhausted } from "@/lib/utils";

export const prerender = false;

const { user } = Astro.locals;
const { id } = Astro.params;
const isValidId = id != null && z.uuid().safeParse(id).success;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const yarn = supabase && user && isValidId ? await getYarnById(supabase, user.id, id) : null;

const error = Astro.url.searchParams.get("error");
const warning = Astro.url.searchParams.get("warning");
const editOpen = Astro.url.searchParams.get("edit") === "1";

const suggestions = supabase && user && yarn ? await listSubstituteSuggestions(supabase, user.id, yarn.id) : [];
const acceptedSubstitutes = supabase && user && yarn ? await getAcceptedSubstitutes(supabase, user.id, yarn.id) : [];

if (!yarn) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/dashboard");
}

const quantityLabel = yarn
  ? [
      yarn.quantity_skeins != null ? `${yarn.quantity_skeins} motków` : null,
      yarn.quantity_grams != null ? `${yarn.quantity_grams} g` : null,
    ]
      .filter(Boolean)
      .join(" / ")
  : "";

const chipClass = "bg-secondary inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm";
const exhaustedChipClass =
  "border-warning-border bg-warning text-warning-foreground inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm";
const rating = yarn?.rating ?? null;
const exhausted = yarn ? isYarnExhausted(yarn) : false;
---

{
  yarn && (
    <Layout title={yarn.name}>
      <div class="min-h-screen p-4 sm:p-8">
        <div class="mx-auto max-w-2xl">
          {error && (
            <p class="border-error-border bg-error text-error-foreground mb-4 flex items-center gap-2 rounded-lg border px-3 py-2 text-sm">
              <CircleAlert className="size-4 shrink-0" />
              {error}
            </p>
          )}
          {warning && (
            <p class="border-warning-border bg-warning text-warning-foreground mb-4 flex items-center gap-2 rounded-lg border px-3 py-2 text-sm">
              <TriangleAlert className="size-4 shrink-0" />
              {warning}
            </p>
          )}

          <div class="mb-4 flex items-center justify-between gap-4">
            <a href="/dashboard" class="text-primary inline-block text-sm hover:underline">
              ← Wróć do biblioteki
            </a>
            <div class="flex items-center gap-2">
              <EditYarnDialog yarn={yarn} serverError={error} defaultOpen={editOpen} client:load />
              <DeleteYarnButton yarnId={yarn.id} yarnName={yarn.name} client:load />
            </div>
          </div>

          <div class="border-border bg-card overflow-hidden rounded-2xl border">
            <div class="bg-secondary aspect-[4/3] w-full">
              {yarn.photoUrl ? (
                <img src={yarn.photoUrl} alt={yarn.name} class="h-full w-full object-cover" />
              ) : (
                <YarnPhotoPlaceholder class="text-muted-foreground h-full w-full p-16" />
              )}
            </div>

            <div class="space-y-6 p-6">
              <section>
                <h1 class="text-2xl font-bold">{yarn.name}</h1>
                <p class="text-muted-foreground mt-1">{yarn.manufacturer}</p>
              </section>

              <section class="flex flex-wrap gap-2">
                {quantityLabel && <span class:list={chipClass}>{quantityLabel}</span>}
                {exhausted && <span class:list={exhaustedChipClass}>Wyczerpana</span>}
                {yarn.color && <span class:list={chipClass}>Kolor: {yarn.color}</span>}
                {yarn.dye_lot && <span class:list={chipClass}>Farbowanie: {yarn.dye_lot}</span>}
                {yarn.needle_size_mm != null && <span class:list={chipClass}>Druty {yarn.needle_size_mm} mm</span>}
                {yarn.hook_size_mm != null && <span class:list={chipClass}>Szydełko {yarn.hook_size_mm} mm</span>}
              </section>

              {yarn.composition && yarn.composition.length > 0 && (
                <section>
                  <h2 class="text-muted-foreground mb-2 text-sm font-semibold">Skład</h2>
                  <div class="flex flex-wrap gap-2">
                    {yarn.composition.map((row) => (
                      <span class:list={chipClass}>
                        {row.fiber} {row.percent}%
                      </span>
                    ))}
                  </div>
                </section>
              )}

              {rating && (
                <section>
                  <h2 class="text-muted-foreground mb-2 text-sm font-semibold">Ocena</h2>
                  <div class="flex items-center gap-1">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <Star
                        className={`size-5 ${i < rating ? "fill-warning-border text-warning-border" : "text-border"}`}
                      />
                    ))}
                  </div>
                </section>
              )}

              {yarn.gauge_note && (
                <section class="border-border bg-secondary rounded-xl border p-4">
                  <h2 class="text-muted-foreground mb-2 text-sm font-semibold">Próbka</h2>
                  <p class="text-sm whitespace-pre-wrap">{yarn.gauge_note}</p>
                </section>
              )}

              {yarn.note && (
                <section>
                  <h2 class="text-muted-foreground mb-2 text-sm font-semibold">Notatka</h2>
                  <p class="text-sm whitespace-pre-wrap">{yarn.note}</p>
                </section>
              )}

              <SubstituteSuggestions
                yarnId={yarn.id}
                initialSuggestions={suggestions}
                initialAccepted={acceptedSubstitutes}
                client:load
              />
            </div>
          </div>
        </div>
      </div>
    </Layout>
  )
}
