---
import { Star } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import YarnPhotoPlaceholder from "@/components/yarn/YarnPhotoPlaceholder.astro";
import { createClient } from "@/lib/supabase";
import { getYarnById } from "@/lib/services/yarns";

export const prerender = false;

const { user } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const yarn = supabase && user && id ? await getYarnById(supabase, id) : null;

if (!yarn) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/dashboard");
}

const quantityLabel = yarn
  ? [
      yarn.quantity_skeins != null ? `${yarn.quantity_skeins} motków` : null,
      yarn.quantity_grams != null ? `${yarn.quantity_grams} g` : null,
    ]
      .filter(Boolean)
      .join(" / ")
  : "";

const chipClass = "inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-sm text-blue-100/90";
const rating = yarn?.rating ?? null;
---

{
  yarn && (
    <Layout title={yarn.name}>
      <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
        <div class="mx-auto max-w-2xl">
          <a href="/dashboard" class="mb-4 inline-block text-sm text-purple-300 hover:underline">
            ← Wróć do biblioteki
          </a>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
            <div class="aspect-[4/3] w-full bg-white/5">
              {yarn.photoUrl ? (
                <img src={yarn.photoUrl} alt={yarn.name} class="h-full w-full object-cover" />
              ) : (
                <YarnPhotoPlaceholder class="h-full w-full p-16 text-blue-100/30" />
              )}
            </div>

            <div class="space-y-6 p-6">
              <section>
                <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
                  {yarn.name}
                </h1>
                <p class="mt-1 text-blue-100/70">{yarn.manufacturer}</p>
              </section>

              <section class="flex flex-wrap gap-2">
                {quantityLabel && <span class:list={chipClass}>{quantityLabel}</span>}
                {yarn.color && <span class:list={chipClass}>Kolor: {yarn.color}</span>}
                {yarn.dye_lot && <span class:list={chipClass}>Farbowanie: {yarn.dye_lot}</span>}
                {yarn.needle_size_mm != null && <span class:list={chipClass}>Druty {yarn.needle_size_mm} mm</span>}
                {yarn.hook_size_mm != null && <span class:list={chipClass}>Szydełko {yarn.hook_size_mm} mm</span>}
              </section>

              {yarn.composition && yarn.composition.length > 0 && (
                <section>
                  <h2 class="mb-2 text-sm font-semibold text-blue-100/80">Skład</h2>
                  <div class="flex flex-wrap gap-2">
                    {yarn.composition.map((row) => (
                      <span class:list={chipClass}>
                        {row.fiber} {row.percent}%
                      </span>
                    ))}
                  </div>
                </section>
              )}

              {rating && (
                <section>
                  <h2 class="mb-2 text-sm font-semibold text-blue-100/80">Ocena</h2>
                  <div class="flex items-center gap-1">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <Star className={`size-5 ${i < rating ? "fill-yellow-300 text-yellow-300" : "text-white/20"}`} />
                    ))}
                  </div>
                </section>
              )}

              {yarn.gauge_note && (
                <section class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <h2 class="mb-2 text-sm font-semibold text-blue-100/80">Próbka</h2>
                  <p class="text-sm whitespace-pre-wrap text-blue-100/90">{yarn.gauge_note}</p>
                </section>
              )}

              {yarn.note && (
                <section>
                  <h2 class="mb-2 text-sm font-semibold text-blue-100/80">Notatka</h2>
                  <p class="text-sm whitespace-pre-wrap text-blue-100/90">{yarn.note}</p>
                </section>
              )}
            </div>
          </div>
        </div>
      </div>
    </Layout>
  )
}
