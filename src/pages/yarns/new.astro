---
import Layout from "@/layouts/Layout.astro";
import AddYarnForm from "@/components/yarn/AddYarnForm";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<Layout title="Dodaj włóczkę">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Dodaj włóczkę
      </h1>
      <AddYarnForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        <a href="/dashboard" class="text-purple-300 hover:underline">Wróć do biblioteki</a>
      </p>
    </div>
  </div>
</Layout>
